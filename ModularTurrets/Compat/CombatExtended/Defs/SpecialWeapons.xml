<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Existing CE stock supplies these weapons. Each gun-specific AmmoSet maps
       that stock to its own projectile; other CE weapons are not changed. -->
  <CombatExtended.AmmoSetDef>
    <defName>MT_CE_AmmoSet_Laser</defName><label>mounted laser charged ammunition</label>
    <ammoTypes><Ammo_8x35mmCharged>MT_CE_Projectile_Laser</Ammo_8x35mmCharged></ammoTypes>
  </CombatExtended.AmmoSetDef>
  <CombatExtended.AmmoSetDef>
    <defName>MT_CE_AmmoSet_Tesla</defName><label>mounted Tesla charged ammunition</label>
    <ammoTypes><Ammo_8x35mmCharged>MT_CE_Projectile_Tesla</Ammo_8x35mmCharged></ammoTypes>
  </CombatExtended.AmmoSetDef>
  <CombatExtended.AmmoSetDef>
    <defName>MT_CE_AmmoSet_Quantum</defName><label>mounted quantum charged ammunition</label>
    <ammoTypes><Ammo_8x35mmCharged>MT_CE_Projectile_Quantum</Ammo_8x35mmCharged></ammoTypes>
  </CombatExtended.AmmoSetDef>
  <CombatExtended.AmmoSetDef>
    <defName>MT_CE_AmmoSet_Missile</defName><label>mounted miniature HE ammunition</label>
    <ammoTypes><Ammo_40x46mmGrenade_HE>MT_CE_Projectile_Missile</Ammo_40x46mmGrenade_HE></ammoTypes>
  </CombatExtended.AmmoSetDef>

  <ThingDef Class="CombatExtended.Lasers.LaserBeamDefCE" ParentName="BaseLaserBulletTextured">
    <defName>MT_CE_Projectile_Laser</defName><label>mounted laser beam</label>
    <thingClass>ModularTurrets.Compat.CombatExtended.Projectile_MountedLaserCE</thingClass>
    <bringAlongOnGravship>false</bringAlongOnGravship>
    <shieldDamageMultiplier>0.5</shieldDamageMultiplier>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>MT_LaserDamage</damageDef><damageAmountBase>22</damageAmountBase>
      <armorPenetrationSharp>16</armorPenetrationSharp><armorPenetrationBlunt>24</armorPenetrationBlunt>
      <isInstant>true</isInstant><damageFalloff>false</damageFalloff><speed>150</speed>
      <trajectoryWorker>CombatExtended.LerpedTrajectoryWorker</trajectoryWorker><castShadow>false</castShadow>
    </projectile>
  </ThingDef>
  <ThingDef Name="MT_CE_FieldProjectileBase" ParentName="BaseBulletCE" Abstract="True">
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <isInstant>true</isInstant><damageFalloff>false</damageFalloff><speed>150</speed>
      <trajectoryWorker>CombatExtended.LerpedTrajectoryWorker</trajectoryWorker><castShadow>false</castShadow>
      <suppressionFactor>0</suppressionFactor><airborneSuppressionFactor>0</airborneSuppressionFactor>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="MT_CE_FieldProjectileBase">
    <defName>MT_CE_Projectile_Quantum</defName><label>mounted quantum impact</label>
    <thingClass>ModularTurrets.Compat.CombatExtended.Projectile_MountedQuantumCE</thingClass>
    <bringAlongOnGravship>false</bringAlongOnGravship>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>MT_QuantumDamage</damageDef><damageAmountBase>4</damageAmountBase>
      <armorPenetrationSharp>16</armorPenetrationSharp><armorPenetrationBlunt>24</armorPenetrationBlunt>
    </projectile>
  </ThingDef>
  <ThingDef Name="MT_CE_TeslaProjectileBase" ParentName="MT_CE_FieldProjectileBase" Abstract="True">
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>MT_TeslaDischarge</damageDef><damageAmountBase>12</damageAmountBase>
      <armorPenetrationSharp>8</armorPenetrationSharp><armorPenetrationBlunt>12</armorPenetrationBlunt>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="MT_CE_TeslaProjectileBase">
    <defName>MT_CE_Projectile_Tesla</defName><label>mounted Tesla pulse</label>
    <thingClass>ModularTurrets.Compat.CombatExtended.Projectile_MountedTeslaCE</thingClass>
    <bringAlongOnGravship>false</bringAlongOnGravship>
  </ThingDef>
  <ThingDef ParentName="MT_CE_TeslaProjectileBase">
    <defName>MT_CE_Projectile_TeslaHit</defName><label>mounted Tesla pulse impact</label>
    <thingClass>ModularTurrets.Compat.CombatExtended.Projectile_MountedPulseHitCE</thingClass>
    <bringAlongOnGravship>false</bringAlongOnGravship>
  </ThingDef>
  <ThingDef ParentName="BaseBulletCE">
    <defName>MT_CE_Projectile_Missile</defName><label>mounted curved miniature missile</label>
    <thingClass>ModularTurrets.Compat.CombatExtended.Projectile_MountedMissileCE</thingClass>
    <bringAlongOnGravship>false</bringAlongOnGravship>
    <graphicData><texPath>ModularTurrets/Projectile-Missile</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(0.26,0.78)</drawSize></graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bomb</damageDef><damageAmountBase>6</damageAmountBase>
      <armorPenetrationSharp>8</armorPenetrationSharp><armorPenetrationBlunt>12</armorPenetrationBlunt>
      <speed>55</speed><explosionRadius>2.4</explosionRadius><explosionDamageFalloff>true</explosionDamageFalloff>
      <trajectoryWorker>ModularTurrets.Compat.CombatExtended.MountedMissileTrajectoryCE</trajectoryWorker>
    </projectile>
    <modExtensions><li Class="ModularTurrets.MissileFlightExtension">
      <curveWidth>4.5</curveWidth><distanceWidthLimit>0.25</distanceWidthLimit><durationMultiplier>1.35</durationMultiplier>
      <smokeInterval>2</smokeInterval><smokeSize>0.35</smokeSize>
    </li></modExtensions>
  </ThingDef>
</Defs>
