      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_DualMortar</defName>
        <statBases>
          <SightsEfficiency>1.0</SightsEfficiency>
          <ShotSpread>0.1</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedMortarCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_81mmMortarShell_HE</defaultProjectile>
          <range>700</range>
          <circularError>1</circularError>
          <indirectFirePenalty>0.2</indirectFirePenalty>
          <warmupTime>3.5</warmupTime>
          <burstShotCount>2</burstShotCount>
          <ticksBetweenBurstShots>30</ticksBetweenBurstShots>
          <soundCast>Mortar_LaunchA</soundCast>
          <muzzleFlashScale>1.85</muzzleFlashScale>
          <minRange>32</minRange>
          <requireLineOfSight>false</requireLineOfSight>
          <!-- CE owns ballistic dispersion; its ProjectileCE is not Core Projectile_Explosive. -->
          <forcedMissRadius>0</forcedMissRadius>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>2</magazineSize>
          <reloadTime>4</reloadTime>
          <ammoSet>AmmoSet_81mmMortarShell</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
      </li>
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_Flamethrower</defName>
        <statBases>
          <SightsEfficiency>1.0</SightsEfficiency>
          <ShotSpread>0.5</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_Flamethrower_Napalm</defaultProjectile>
          <forcedMissRadius>0</forcedMissRadius>
          <range>6</range>
          <warmupTime>0.8</warmupTime>
          <burstShotCount>8</burstShotCount>
          <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
          <soundCast>Shot_IncendiaryLauncher</soundCast>
          <muzzleFlashScale>1</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
