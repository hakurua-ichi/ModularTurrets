<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- CE's gun conversion removes only vanilla verb names, not MT's custom verbs. -->
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName='MT_Gun_Autocannon' or defName='MT_Gun_Sniper' or defName='MT_Gun_DualAutocannon' or defName='MT_Gun_DualSniper' or defName='MT_Gun_DualMortar' or defName='MT_Gun_Flamethrower' or defName='MT_Gun_Minigun' or defName='MT_Gun_Auxiliary' or defName='MT_Gun_Laser' or defName='MT_Gun_Tesla' or defName='MT_Gun_Quantum' or defName='MT_Gun_Missile']/verbs/li[verbClass='ModularTurrets.Verb_ModularShoot' or verbClass='ModularTurrets.Verb_ModularMortar' or verbClass='ModularTurrets.Verb_Instant' or verbClass='ModularTurrets.Verb_Tesla' or verbClass='ModularTurrets.Verb_Quantum']</xpath>
      </li>
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_Autocannon</defName>
        <statBases>
          <SightsEfficiency>1.2</SightsEfficiency>
          <ShotSpread>0.15</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_20x102mmNATO_AP</defaultProjectile>
          <range>28.9</range>
          <warmupTime>1.4</warmupTime>
          <burstShotCount>3</burstShotCount>
          <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
          <soundCast>Shot_Autocannon</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>4</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>120</magazineSize>
          <reloadTime>6</reloadTime>
          <ammoSet>AmmoSet_Autocannon</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
      </li>
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_Sniper</defName>
        <statBases>
          <SightsEfficiency>1.8</SightsEfficiency>
          <ShotSpread>0.03</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_50BMG_FMJ</defaultProjectile>
          <range>48</range>
          <warmupTime>2.4</warmupTime>
          <burstShotCount>1</burstShotCount>
          <ticksBetweenBurstShots>0</ticksBetweenBurstShots>
          <soundCast>Shot_TurretSniper</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>4</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>10</magazineSize>
          <reloadTime>5</reloadTime>
          <ammoSet>AmmoSet_AntiMateriel</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
      </li>
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_DualAutocannon</defName>
        <statBases>
          <SightsEfficiency>1.2</SightsEfficiency>
          <ShotSpread>0.15</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_20x102mmNATO_AP</defaultProjectile>
          <range>36</range>
          <warmupTime>1.8</warmupTime>
          <burstShotCount>6</burstShotCount>
          <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
          <soundCast>Shot_Autocannon</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>1.55</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>160</magazineSize>
          <reloadTime>7</reloadTime>
          <ammoSet>AmmoSet_Autocannon</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
