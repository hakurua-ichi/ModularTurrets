      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_Minigun</defName>
        <statBases>
          <SightsEfficiency>0.8</SightsEfficiency>
          <ShotSpread>0.35</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
          <range>34</range>
          <warmupTime>1.8</warmupTime>
          <burstShotCount>60</burstShotCount>
          <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
          <soundCast>Shot_Minigun</soundCast>
          <soundCastTail>GunTail_Medium</soundCastTail>
          <muzzleFlashScale>4</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>600</magazineSize>
          <reloadTime>8</reloadTime>
          <ammoSet>AmmoSet_Rifle</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
      </li>
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>MT_Gun_Auxiliary</defName>
        <statBases>
          <SightsEfficiency>1.0</SightsEfficiency>
          <ShotSpread>0.2</ShotSpread>
          <SwayFactor>1</SwayFactor>
          <Bulk>10</Bulk>
        </statBases>
        <Properties>
          <verbClass>ModularTurrets.Compat.CombatExtended.Verb_MountedShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
          <range>24</range>
          <warmupTime>0.7</warmupTime>
          <burstShotCount>3</burstShotCount>
          <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
          <soundCast>Shot_Minigun</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>4</muzzleFlashScale>
          <targetParams>
            <canTargetPawns>true</canTargetPawns>
            <canTargetBuildings>true</canTargetBuildings>
            <canTargetLocations>true</canTargetLocations>
          </targetParams>
          <recoilAmount>0.2</recoilAmount>
          <useEquipmentStatValues>false</useEquipmentStatValues>
        </Properties>
        <AmmoUser>
          <magazineSize>60</magazineSize>
          <reloadTime>4</reloadTime>
          <ammoSet>AmmoSet_Rifle</ammoSet>
        </AmmoUser>
        <FireModes />
        <weaponTags>
          <li>CE_MT_Mounted</li>
        </weaponTags>
      </li>
      <!-- Match CE's standard 81mm mortar charge selector; the shell itself has speed0. -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName='MT_Gun_DualMortar']/comps</xpath>
        <value>
          <li Class="CombatExtended.CompProperties_Charges">
            <chargeSpeeds><li>30</li><li>50</li><li>70</li><li>90</li></chargeSpeeds>
          </li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName='MT_TurretBase']/comps</xpath>
        <value>
          <li Class="ModularTurrets.Compat.CombatExtended.CompProperties_MountedCE" />
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
