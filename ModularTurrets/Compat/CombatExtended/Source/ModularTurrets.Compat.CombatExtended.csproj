<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ModularTurrets.Compat.CombatExtended</AssemblyName>
    <Version>0.1.1</Version>
    <GameRoot Condition="'$(GameRoot)' == ''">F:\SteamLibrary\steamapps\common\RimWorld</GameRoot>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(GameRoot)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Import Project="CompileOrder.props" />
  <ItemGroup>
    <Reference Include="ModularTurrets" HintPath="../../../Assemblies/ModularTurrets.dll" Private="false" />
    <Reference Include="CombatExtended" HintPath="$(CombatExtendedPath)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameRoot)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(GameRoot)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(GameRoot)/Waylith.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" Private="false" />
  </ItemGroup>
  <Target Name="RequireCombatExtendedReference" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CombatExtendedPath)' == '' Or !Exists('$(CombatExtendedPath)')" Text="Pass -p:CombatExtendedPath pointing to a compatible RimWorld 1.7 CombatExtended.dll. Core builds do not require this optional project." />
  </Target>
</Project>
