<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MT_ModularBattery</defName>
    <label>modular battery</label>
    <description>An upgradeable, weatherproof 3x3 battery with a central 1x3 body and two 1x3 side-module slots. Base storage is 1,200 Wd and charging efficiency is 80%. Each base upgrade costs 80 steel and 2 industrial components and adds 1,200 Wd before storage-module bonuses.</description>
    <thingClass>ModularTurrets.Batteries.Building_ModularBattery</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <graphicData>
      <texPath>ModularTurrets/Batteries/Battery</texPath>
      <graphicClass>ModularTurrets.Batteries.Graphic_ModularBattery</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3,3)</drawSize>
      <drawRotated>true</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <WorkToBuild>1750</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>1</Flammability>
      <Beauty>-15</Beauty>
    </statBases>
    <costList>
      <Steel>280</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="ModularTurrets.Batteries.CompProperties_ModularBattery">
        <storedEnergyMax>1200</storedEnergyMax>
        <efficiency>0.8</efficiency>
        <shortCircuitInRain>false</shortCircuitInRain>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="ModularTurrets.Batteries.CompProperties_BatteryGeneration" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiOrder>2021</uiOrder>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>MT_ModularBatteries</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="ModularTurrets.Batteries.BatterySettingsExtension">
        <capacityPerUpgrade>1200</capacityPerUpgrade>
        <upgradeSteel>80</upgradeSteel>
        <upgradeComponents>2</upgradeComponents>
        <upgradeWork>600</upgradeWork>
        <installWork>100</installWork>
        <removeWork>100</removeWork>
      </li>
    </modExtensions>
  </ThingDef>
  <ResearchProjectDef>
