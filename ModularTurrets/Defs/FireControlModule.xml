<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ModularTurrets.ModuleEffectDef>
    <defName>MT_FireControlEffect</defName>
    <label>precision fire control</label>
    <description>Improves aiming and protects non-hostile faction pawns. Mounted effects follow the active combat system and turret head.</description>
    <workerClass>ModularTurrets.ModuleEffect_Stats</workerClass>
    <accuracyMissReductionPerPower>0.125</accuracyMissReductionPerPower>
    <mortarScatterReductionBase>0.10</mortarScatterReductionBase>
    <mortarScatterReductionPerTier>0.05</mortarScatterReductionPerTier>
    <preventFriendlyFire>true</preventFriendlyFire>
  </ModularTurrets.ModuleEffectDef>
  <ThingDef ParentName="MT_PartBase">
    <defName>MT_Module_FireControl</defName>
    <thingCategories Inherit="False">
      <li>MT_GeneralModules</li>
    </thingCategories>
    <label>precision fire control module</label>
    <description>An aiming and friendly-fire protection module. Assembly management and item details show effects for the current turret and combat system. The upgrade tier is retained after removal. Aggressive mental states, spreading fire and collapses are excluded from protection.</description>
    <graphicData>
      <texPath>ModularTurrets/Components/FanPod-left</texPath>
      <graphicClass>ModularTurrets.Graphic_LoosePartOutline</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3.80167224,3.75050167)</drawSize>
      <drawOffset>(0.82173913,0,0.25133779)</drawOffset>
    </graphicData>
    <statBases>
      <Mass>8</Mass>
      <MarketValue>1400</MarketValue>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>9</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <modExtensions>
      <li Class="ModularTurrets.PartExtension">
        <moduleKind>FireControl</moduleKind>
        <power>120</power>
        <effects>
          <li>MT_FireControlEffect</li>
        </effects>
