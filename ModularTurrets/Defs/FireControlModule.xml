      <li Class="ModularTurrets.ParagonModuleExtension">
        <powerMultiplier>8</powerMultiplier>
        <auxiliaryDamageMultiplier>4</auxiliaryDamageMultiplier>
        <auxiliaryBurstMultiplier>2</auxiliaryBurstMultiplier>
        <powerConsumptionMultiplier>4</powerConsumptionMultiplier>
