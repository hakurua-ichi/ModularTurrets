<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Optional audition profile. All grains reference Core resources; no audio is bundled. -->
  <SoundDef>
    <defName>MT_TrialShot_Autocannon</defName>
    <context>MapOnly</context>
    <maxVoices>6</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/Autocannon</clipFolderPath></li></grains>
      <volumeRange>62~66</volumeRange>
      <pitchRange>0.76~0.84</pitchRange>
      <distRange>18~90</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Sniper</defName>
    <context>MapOnly</context>
    <maxVoices>3</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/SniperRifle</clipFolderPath></li></grains>
      <volumeRange>72~76</volumeRange>
      <pitchRange>0.62~0.70</pitchRange>
      <distRange>18~100</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Flamethrower</defName>
    <context>MapOnly</context>
