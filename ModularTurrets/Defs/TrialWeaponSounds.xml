      <pitchRange>0.78~0.86</pitchRange>
      <distRange>15~85</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Laser</defName>
    <context>MapOnly</context>
    <maxVoices>3</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <grains><li Class="AudioGrain_Clip"><clipPath>Weapon/ChargeShotA</clipPath></li></grains>
      <volumeRange>65~70</volumeRange>
      <pitchRange>0.74~0.82</pitchRange>
      <distRange>18~95</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Missile</defName>
    <context>MapOnly</context>
    <maxVoices>5</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/RocketswarmLauncher/Cast</clipFolderPath></li></grains>
      <volumeRange>40~44</volumeRange>
      <pitchRange>0.76~0.86</pitchRange>
      <distRange>18~95</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Tesla</defName>
    <context>MapOnly</context>
    <maxVoices>3</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <grains><li Class="AudioGrain_Clip"><clipPath>Weapon/Artillery/EMPExplosion_01d</clipPath></li></grains>
      <volumeRange>42~46</volumeRange>
      <pitchRange>1.00~1.08</pitchRange>
      <distRange>15~80</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Quantum</defName>
    <context>MapOnly</context>
    <maxVoices>8</maxVoices>
    <maxSimultaneous>8</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <!-- The shortest Core charge-rifle sample avoids randomized long tails at 20 shots/s. -->
      <grains><li Class="AudioGrain_Clip"><clipPath>Weapon/ChargeRifle/ShotChargeRifle_1b</clipPath></li></grains>
      <volumeRange>22~25</volumeRange>
      <pitchRange>1.15~1.22</pitchRange>
      <distRange>15~85</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Auxiliary</defName>
