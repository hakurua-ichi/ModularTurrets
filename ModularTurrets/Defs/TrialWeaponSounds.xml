    <subSounds><li>
      <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/Minigun/Shot</clipFolderPath></li></grains>
      <volumeRange>22~25</volumeRange>
      <pitchRange>0.88~0.96</pitchRange>
      <distRange>12~75</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialTail_Heavy</defName>
    <context>MapOnly</context>
    <maxVoices>2</maxVoices>
    <maxSimultaneous>1</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
    <subSounds><li>
      <onCamera>true</onCamera>
      <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/Tails/Heavy</clipFolderPath></li></grains>
      <volumeRange>20~23</volumeRange>
      <pitchRange>0.80~0.88</pitchRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
</Defs>
