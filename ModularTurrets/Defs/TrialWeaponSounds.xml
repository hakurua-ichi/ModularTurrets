      <volumeRange>33~37</volumeRange>
      <pitchRange>0.88~0.98</pitchRange>
      <distRange>12~65</distRange>
      <sustainLoop>false</sustainLoop>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MT_TrialShot_Minigun</defName>
    <context>MapOnly</context>
    <maxVoices>8</maxVoices>
    <maxSimultaneous>2</maxSimultaneous>
    <priorityMode>PrioritizeNewest</priorityMode>
