<Defs>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>MT_Gun_Autocannon</defName>
    <label>autocannon</label>
    <description>An internal weapon operated by a modular turret.</description>
    <graphicData>
      <!-- BuildingProperties resolves this hidden reference directly as a texture. -->
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>4.8</RangedWeapon_Cooldown>
      <AccuracyTouch>0.9</AccuracyTouch>
      <AccuracyShort>0.92</AccuracyShort>
      <AccuracyMedium>0.88</AccuracyMedium>
      <AccuracyLong>0.85</AccuracyLong>
