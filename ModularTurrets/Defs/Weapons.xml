        <compClass>ModularTurrets.CompTurretWeaponAccuracy</compClass>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>ModularTurrets.Verb_ModularShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MT_Projectile_Autocannon</defaultProjectile>
